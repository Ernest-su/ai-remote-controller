<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="ernest.airc.ShareReceiptActivity" android:exported="true"
            android:label="AIRC 截图验收" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
            </intent-filter>
        </activity>
    </application>
</manifest>
