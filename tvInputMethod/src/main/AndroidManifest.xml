<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:allowBackup="false" android:supportsRtl="true">
        <service android:name=".RemoteInputMethod" android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
        <provider android:name=".InputProvider" android:authorities="ernest.airc.ime.control"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
